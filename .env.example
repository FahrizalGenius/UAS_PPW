FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ppw_pagerank
DB_USER=root
DB_PASSWORD=

# Crawler configuration
MAX_CRAWL_PAGES=300
CRAWL_REQUEST_TIMEOUT=10
CRAWL_REQUEST_DELAY=0.5
CRAWL_USER_AGENT=Mozilla/5.0 (compatible; PPW-PageRankBot/1.0; +https://trunojoyo.ac.id/)

# PageRank configuration
PAGERANK_DAMPING_FACTOR=0.85
PAGERANK_MAX_ITER=100
PAGERANK_TOL=0.000001
